# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Provider hỗ trợ: "9router", "gemini", "openai", "mock" (offline)
LLM_PROVIDER=9router

# 9router: URL API đầy đủ, thường kết thúc bằng /v1
# Ví dụ local: http://localhost:20128/v1
NINE_ROUTER_BASE_URL=
# Key lấy từ dashboard 9router, không phải key trực tiếp của Gemini/OpenAI
NINE_ROUTER_API_KEY=your_9router_api_key_here
# ID model hoặc combo có hỗ trợ tool calling từ dashboard 9router
NINE_ROUTER_MODEL=

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
# Đường dẫn tùy chọn cho lịch dạng JSON. Bỏ trống cấu hình này để dùng data/farm_tasks.json.
# FARM_TASKS_FILE=/absolute/path/to/farm_tasks.json
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
